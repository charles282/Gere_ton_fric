NODE_ENV=development
PORT=3000

# Postgres — rôle applicatif restreint, soumis à Row-Level Security
DATABASE_URL=postgresql://budgetly_app:changeme_app@localhost:5433/budgetly

# Postgres — rôle propriétaire des tables, utilisé uniquement pour les migrations
DATABASE_MIGRATIONS_URL=postgresql://budgetly_migrator:changeme@localhost:5433/budgetly

# Dev uniquement — simule un utilisateur avant que l'authentification existe
DEFAULT_DEV_USER_ID=
